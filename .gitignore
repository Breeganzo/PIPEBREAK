# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets - .env holds a real API key and must never be published.
# .env.example is the shareable template and IS committed.
.env
.env.local
*.key

# Generated warehouses and task instances. These are rebuilt from a fixed seed
# by `python -m pipebreak build`, so they are reproducible rather than precious,
# and they are far too large to keep in version control.
work/

# Run artefacts that are noise rather than results. There is one progress
# heartbeat and one log per model, because models are swept in parallel
# processes. The scores_*.json files ARE results and are deliberately kept.
results/progress_*.json
results/progress.json
results/sweep_*.log
results/sweep.log

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*

# macOS
.DS_Store

# Editors
.idea/
*.swp
