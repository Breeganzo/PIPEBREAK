# PIPEBREAK configuration
#
# Copy this file to .env and fill in your own key:
#     cp .env.example .env
#
# .env holds a real secret and must never be shared or published.
# This file (.env.example) is the shareable template and holds no secret.

# Required. Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional. Comma-separated list of models to evaluate.
# Leave unset to use the default three. Availability varies by account -
# list yours with:  python -m pipebreak models
# PIPEBREAK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
